# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
env/
venv/
.venv/

# Editor and office lock files
.~lock.*#
*.swp
*~

# Superseded campaigns, recorded with the uncorrected decision node. They are kept out of
# the package but left on disk; the published campaigns live in data/v2_sweep, v2_dispersion,
# v3_roundrobin and v4_predicted.
data/new_areas/**/*.bag
data/new_areas/**/params_*.yaml
data/new_areas_/**/*.bag
data/new_areas_/**/params_*.yaml
data/old/
data/svr_predictions/

# Metric caches rebuilt by the analysis scripts
*_metrics.pkl

# Campaign run logs (verbose, machine-specific)
*.log
